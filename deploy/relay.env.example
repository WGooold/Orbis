HOST=0.0.0.0
PORT=8787
ORBIS_STATE_FILE=/data/relay-state.json
ORBIS_ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional legacy CLI Host credential; GUI registration creates scoped credentials.
# ORBIS_RUNTIME_CREDENTIAL=another-independent-random-secret
ORBIS_TRUST_PROXY=1
# Advertise native QUIC only after deploying the same-host adapter with valid TLS.
# Use an unused UDP port if Hysteria 2 already occupies UDP/443. See docs/native-quic.md.
# ORBIS_QUIC_PORT=443
# Enable only after the adapter's /v1/runtime route is deployed and verified.
# ORBIS_QUIC_HOST_ENABLED=1
# Advertise five streams only after deploying the matching v3 native adapter.
# ORBIS_RELAY_QUIC_HISTORY_STREAMS=1
# QQ verification defaults to required; manage the switch in the admin console.
# SMTP setup and delivery checks: docs/mail-server.md. Keep credentials server-side.
# Use a certificate-matching DNS-only hostname for self-hosted mail (Cloudflare).
# Apply environment changes through the Relay deploy workflow at a new commit.
# ORBIS_SMTP_HOST=smtp.example.com
# ORBIS_SMTP_PORT=465
# ORBIS_SMTP_USER=sender@example.com
# ORBIS_SMTP_PASSWORD=server-side-smtp-authorization-secret
# ORBIS_SMTP_FROM=Orbis <sender@example.com>
