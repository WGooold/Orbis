{
  "name": "@orbis/pi-extension",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@orbis/e2e": "0.1.0",
    "@orbis/interaction-sdk": "0.1.0",
    "@orbis/protocol": "0.1.0",
    "@orbis/runtime-bridge": "0.1.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WGooold/Orbis.git"
  }
}
