{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@orbis/protocol": ["packages/protocol/src/index.ts"],
      "@orbis/e2e": ["packages/e2e/src/index.ts"],
      "@orbis/host": ["packages/host/src/index.ts"],
      "@orbis/relay": ["packages/relay/src/index.ts"],
      "@orbis/runtime-bridge": ["packages/runtime-bridge/src/index.ts"],
      "@orbis/interaction-sdk": ["packages/remote-interaction-sdk/src/index.ts"],
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "outDir": "dist"
  }
}
