{
  "name": "orbis",
  "version": "0.1.0",
  "private": true,
  "description": "Native mobile control for Pi and Codex, with an encrypted Windows Host and self-hostable Relay",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -b && node scripts/build-relay-web.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "qrcode": "^1.5.4",
    "vitest": "^4.0.18",
    "ws": "^8.18.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WGooold/Orbis.git"
  }
}
