<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.5">
  <diagram id="recoverable-sync" name="可恢复聊天记录同步模型">
    <mxGraphModel dx="1860" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="990" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="可恢复聊天记录同步模型" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1760" height="50" as="geometry" /></mxCell>
        <mxCell id="3" value="同步可恢复状态；实时 patch 降低延迟；checkpoint 修复缺口；running 时同样允许同步。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1760" height="40" as="geometry" /></mxCell>

        <mxCell id="4" value="源端：原生 Agent ＋ adapter" style="swimlane;html=1;startSize=40;rounded=1;arcSize=8;horizontal=1;pointerEvents=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#b7bdc6;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="480" height="590" as="geometry" /></mxCell>
        <mxCell id="5" value="原生持久历史&#xa;原生会话记录 ＋ 原生分支语义&#xa;由 adapter 确定性重建 Entry 图" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;" vertex="1" parent="4"><mxGeometry x="40" y="70" width="400" height="130" as="geometry" /></mxCell>
        <mxCell id="6" value="源端可恢复状态 S(epoch, seq)&#xa;&#xa;当前 head／turn／完整草稿／工具&#xa;保留“已结束、尚未提交”的内容&#xa;&#xa;先原子更新状态，再发布 patch&#xa;checkpoint 捕获同一个版本边界" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;" vertex="1" parent="4"><mxGeometry x="40" y="300" width="400" height="220" as="geometry" /></mxCell>
        <mxCell id="7" value="Pi：extension 内；Codex / DSH：Host adapter 内" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#4b5563;" vertex="1" parent="4"><mxGeometry x="20" y="530" width="440" height="40" as="geometry" /></mxCell>

        <mxCell id="8" value="传输层" style="swimlane;html=1;startSize=40;rounded=1;arcSize=8;horizontal=1;pointerEvents=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#b7bdc6;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="380" height="590" as="geometry" /></mxCell>
        <mxCell id="9" value="Host / Relay&#xa;&#xa;转发原子 patch&#xa;转发 checkpoint 与历史页&#xa;转发 watermark 与同步请求&#xa;&#xa;不决定正文拼接" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;" vertex="1" parent="8"><mxGeometry x="40" y="300" width="300" height="220" as="geometry" /></mxCell>
        <mxCell id="10" value="不新建 Host 全量历史库" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#4b5563;" vertex="1" parent="8"><mxGeometry x="20" y="530" width="340" height="40" as="geometry" /></mxCell>

        <mxCell id="11" value="APP：版本化状态归并 ＋ 现有 SQLite" style="swimlane;html=1;startSize=40;rounded=1;arcSize=8;horizontal=1;pointerEvents=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#b7bdc6;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="830" height="800" as="geometry" /></mxCell>
        <mxCell id="12" value="版本化 reducer&#xa;&#xa;只接连续 patch；重复幂等&#xa;checkpoint 替换完整 live 集合&#xa;原子提交 head 与当前状态&#xa;&#xa;缺口／重连／周期水位差 → sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;" vertex="1" parent="11"><mxGeometry x="50" y="300" width="310" height="220" as="geometry" /></mxCell>
        <mxCell id="13" value="现有 SQLite 缓存&#xa;不可变 Entry ＋ 分页覆盖&#xa;历史页不移动 head、不改 live" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;" vertex="1" parent="11"><mxGeometry x="460" y="70" width="310" height="130" as="geometry" /></mxCell>
        <mxCell id="14" value="当前会话状态&#xa;epoch / seq / head / turn&#xa;完整 live 草稿与工具集合&#xa;turn = null、空集合也必须传递" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;" vertex="1" parent="11"><mxGeometry x="460" y="300" width="310" height="150" as="geometry" /></mxCell>
        <mxCell id="15" value="独立本地 outbox&#xa;尚未确认的用户发送&#xa;不被 live 快照删除" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;" vertex="1" parent="11"><mxGeometry x="50" y="630" width="310" height="130" as="geometry" /></mxCell>
        <mxCell id="16" value="聊天 UI 投影&#xa;当前分支历史 ＋ live ＋ outbox&#xa;不靠文本相似度猜消息身份" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;" vertex="1" parent="11"><mxGeometry x="460" y="630" width="310" height="130" as="geometry" /></mxCell>

        <mxCell id="17" value="读取与恢复历史" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#596579;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="18" value="版本化状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset" /></mxGeometry></mxCell>
        <mxCell id="19" value="同一协议" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="9" target="12"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset" /></mxGeometry></mxCell>
        <mxCell id="20" value="sync 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="12" target="9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="17" as="offset" /></mxGeometry></mxCell>
        <mxCell id="21" value="sync 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="9" target="6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="17" as="offset" /></mxGeometry></mxCell>
        <mxCell id="22" value="历史只补缓存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="285" /></Array></mxGeometry></mxCell>
        <mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.34;entryX=0;entryY=0.5;" edge="1" parent="1" source="12" target="14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="24" value="按 head 取当前分支" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.67;entryY=0;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" x="0.65" as="geometry"><Array as="points"><mxPoint x="1800" y="285" /><mxPoint x="1800" y="720" /><mxPoint x="1658" y="720" /></Array></mxGeometry></mxCell>
        <mxCell id="25" value="当前 live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.33;exitY=1;entryX=0.33;entryY=0;" edge="1" parent="1" source="14" target="16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="26" value="＋" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="27" value="恢复：取 checkpoint → 替换当前状态 → 接续边界之后的连续 patch。&#xa;任何一次性 started / finished / mapping 事件都不是恢复的必要条件。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="900" height="60" as="geometry" /></mxCell>
